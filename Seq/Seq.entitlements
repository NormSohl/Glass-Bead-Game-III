<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- read-write, not read-only like Graph's - Step 5 adds save/load, which needs to write a
         user-selected file via .fileExporter, not just read one. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- On macOS, App Sandbox gates any audio-input device (including IDAM's composite
         audio+MIDI interface for a USB-connected iPad) behind this entitlement, separately
         from and in addition to the NSMicrophoneUsageDescription/TCC prompt - without it, a
         sandboxed app can be denied access even after the user grants that prompt. Added
         alongside NSMicrophoneUsageDescription (see project.pbxproj) for the same reason. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
