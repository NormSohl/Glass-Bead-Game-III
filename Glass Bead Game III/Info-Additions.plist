<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Network MIDI (RTP-MIDI) uses Bonjour to find peers - iOS 14+ requires both of these
	     declared up front, or the Local Network permission prompt never appears and discovery
	     silently fails. Merged into the auto-generated Info.plist via INFOPLIST_FILE below,
	     since GENERATE_INFOPLIST_FILE's own INFOPLIST_KEY_ build settings can't express an
	     array value like NSBonjourServices - this is Apple's own documented way to combine the
	     two. macOS ignores both keys harmlessly (no equivalent permission gate there), so this
	     applies safely to Graph's single universal target. -->
	<!-- The app uses no encryption beyond what the OS itself provides, so App Store Connect
	     doesn't need to ask the export-compliance question on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>GBG III uses your local network to connect to MIDI gear and other apps over Network MIDI, for live performance.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_apple-midi._udp</string>
	</array>
	<!-- Stage 4a of external-display support: multi-scene must be on before an external-display
	     scene role can ever be offered a connection. This default-role entry alone changes
	     nothing about how the app launches or behaves - SwiftUI's own WindowGroup stays in
	     charge, no custom delegate named yet. Expressed here (not via INFOPLIST_KEY_* build
	     settings, which auto-generated this same dict until now) because a nested array/dict
	     like this can't be written as a flat build setting - same reason NSBonjourServices above
	     needed this file at all. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
